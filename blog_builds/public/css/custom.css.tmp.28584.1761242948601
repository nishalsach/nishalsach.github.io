/* ============================================
   UNIFIED DESIGN SYSTEM
   Single source of truth for all styles
   ============================================ */

/* ---- DESIGN TOKENS ---- */
:root {
	/* Colors - Light Mode */
	--color-primary: #40916c;        /* brighter comfortable green */
	--color-primary-hover: #2d6a4f;  /* darker green on hover */
	--color-text: #4b5563;           /* softer gray */
	--color-text-light: #718096;     /* gray */
	--color-text-muted: #999;        /* muted gray for footer */
	--color-background: #fafafa;     /* soft off-white instead of pure white */
	--color-background-subtle: #f5f5f5;  /* slightly darker gray */
	--color-background-draft: #f9f2f4;   /* pink tint for draft labels */
	--color-border: #e2e8f0;
	--color-border-dark: #cbd5e0;
	--color-selection: #b3d4fc;

	/* Typography scale */
	--font-size-xs: 0.75rem;    /* 12px */
	--font-size-sm: 0.875rem;   /* 14px */
	--font-size-base: 1.0625rem;  /* 17px - slightly larger for Karla */
	--font-size-md: 1.1875rem;  /* 19px */
	--font-size-lg: 1.3rem;     /* ~21px */
	--font-size-heading: 1.5rem; /* 24px - standard subheading size */
	--font-size-xl: 1.6rem;     /* ~26px */
	--font-size-2xl: 2rem;      /* 32px */
	--font-size-3xl: 2.75rem;   /* 44px */

	/* Spacing scale */
	--space-xs: 0.25rem;   /* 4px */
	--space-sm: 0.5rem;    /* 8px */
	--space-md: 1rem;      /* 16px */
	--space-lg: 1.5rem;    /* 24px */
	--space-xl: 2rem;      /* 32px */
	--space-2xl: 3rem;     /* 48px */

	/* Font families */
	--font-body: "Karla", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	--font-heading: "Karla", sans-serif;
	--font-mono: "Courier", monospace;
	--font-serif: Georgia, "Bitstream Charter", serif;
}

/* ============================================
   BASE STYLES
   ============================================ */

body {
	font-family: var(--font-body);
	font-weight: 425;
	color: var(--color-text);
	background-color: var(--color-background);
	line-height: 1.6;
	font-size: var(--font-size-base);
}

html, button, input, select, textarea {
	color: var(--color-text);
}

::selection {
	background: var(--color-selection);
	text-shadow: none;
}

::-moz-selection {
	background: var(--color-selection);
	text-shadow: none;
}

/* ============================================
   TYPOGRAPHY
   ============================================ */

/* Global bold weight */
strong, b {
	font-weight: 575;
}

h1, h2, h3, h4, h5, h6 {
	font-family: var(--font-heading);
	line-height: 1.2;
	color: var(--color-text);
	font-weight: 625;
}

h1 { font-size: var(--font-size-3xl); }
h2 { font-size: var(--font-size-heading); }
h3 { font-size: var(--font-size-lg); }
h4 { font-size: 1.25rem; }
h5 { font-size: var(--font-size-base); }
h6 { font-size: 0.9rem; }

/* Site title matches page title size and weight */
.site-title {
	font-size: var(--font-size-2xl);  /* Same as page-title: 2rem / 32px */
	font-weight: 700 !important;  /* Match page-title weight */
}

.site-description h2 {
	font-weight: 625;
}

/* Prevent first paragraph in divs from having top margin */
div p:first-of-type {
	margin-top: 0;
}

/* ============================================
   LINKS
   ============================================ */

a {
	color: var(--color-primary);
	text-decoration: none;
	word-break: break-word;
	transition: color 0.2s ease;
}

a:hover {
	color: var(--color-primary-hover);
	text-decoration: underline;
}

.site-title a {
	color: var(--color-text);
	text-decoration: none !important;
}

/* ============================================
   BUTTONS & INTERACTIVE ELEMENTS
   ============================================ */

/* Theme toggle button - subtle style */
.theme-toggle {
	background: none;
	border: none;
	cursor: pointer;
	font-size: 1.2rem;
	padding: 0.25rem 0.5rem;
	margin-left: 0.5rem;
	border-radius: 0.25rem;
	transition: all 0.2s ease;
	line-height: 1;
	opacity: 0.6;
}

.theme-toggle:hover {
	background-color: var(--color-background-subtle);
	opacity: 1;
}

.theme-toggle-icon {
	display: inline-block;
}

/* CTA buttons - arrow prefix with faint highlight on hover */
.button1,
a.markdown-btn {
	display: inline-block;
	margin-right: var(--space-sm);
	margin-bottom: var(--space-xs);
	padding: 0.2rem 0.5rem;
	color: var(--color-primary);
	font-size: var(--font-size-base);  /* 16px */
	text-decoration: none;
	border: none;
	background: none;
	border-radius: 0.25rem;
	cursor: pointer;
	transition: all 0.2s ease;
}

.button1::before,
a.markdown-btn::before {
	content: "→ ";
	margin-right: 0.25rem;
}

.button1:hover,
.button1:active,
a.markdown-btn:hover,
a.markdown-btn:active {
	color: var(--color-primary-hover);
	background-color: var(--color-background-subtle);
	text-decoration: none;
}

/* Tag pills - original style */
.post-tags .tags a {
	display: inline-block;
	padding: 0.2rem 0.6rem;
	margin-right: var(--space-sm);
	margin-bottom: var(--space-sm);
	background-color: var(--color-background);
	color: var(--color-primary);
	border: 0.1rem solid var(--color-primary);
	border-radius: 0.5rem;  /* more rounded */
	font-size: var(--font-size-base);  /* same as body */
	line-height: 1;
	font-weight: normal;
	text-align: center;
	text-decoration: none;
	transition: all 0.2s ease;
}

.post-tags .tags a:hover {
	background-color: var(--color-primary);
	color: var(--color-background);
	text-decoration: none;
}

.post-tags .tags li {
	margin-bottom: 0;
	margin-top: var(--space-xl);
}

/* ============================================
   LAYOUT & STRUCTURE
   ============================================ */

.wrapper {
	margin: 0 auto;
	width: 900px;
	max-width: 85vw;
	height: auto;
}

.container {
	max-width: 950px;
	margin-top: 30px;
}

.align-center { text-align: center; }
.align-left { text-align: left; }
.align-right { text-align: right; }

.prevent-collapse {
	min-height: 0.1rem;
}

.smaller,
.text-small {
	font-size: 70%;
}

/* ============================================
   HEADER
   ============================================ */

.header {
	margin-bottom: var(--space-md);
}

.header h1,
.header h2 {
	margin: 0;
	padding: 0;
	font-size: var(--font-size-2xl);
	line-height: 1.3em;
}

.header h2 {
	font-size: var(--font-size-md);
}

.header nav {
	margin-top: var(--space-md);
	border-top: 1px solid var(--color-border);
}

.header nav ul,
.header nav li {
	margin: 0;
}

.header nav ul.flat {
	padding: 0;
}

.header nav ul.flat li {
	display: inline-block;
	list-style: none;
	margin-left: 0;
	margin-right: 10px;
	margin-top: 10px;
	text-transform: capitalize;
}

.header .site-description {
	display: flex;
	justify-content: space-between;
}

.header .site-description nav {
	margin: 0;
	padding: 0;
	border: none;
	min-width: 50px;
	margin-left: 15px;
}

.header .site-description nav ul svg {
	max-height: 15px;
}

/* ============================================
   FOOTER
   ============================================ */

.footer {
	text-align: right;
	font-size: var(--font-size-xs);
	color: var(--color-text-muted);
	border-top: 1px solid var(--color-border);
	padding: var(--space-xl) 0;
	margin-top: 40px;
}

/* ============================================
   HOMEPAGE & NEWS
   ============================================ */

/* Base meta styling - used for dates and metadata */
.meta {
	font-size: var(--font-size-sm);
	color: var(--color-text-light);
}

.recent-posts .posts .post {
	margin-bottom: var(--space-xl);
}

.recent-posts .posts .post .meta {
	text-transform: uppercase;
	letter-spacing: 0.02em;
	margin-bottom: 4px;
}

.post .post-header .meta {
	padding-left: 0;
	margin-top: 0;
}

/* News items */
.news_item {
	font-size: var(--font-size-base);
	line-height: 1.7;
	margin-bottom: var(--space-lg);
	color: var(--color-text);
}

.news_item b,
.news_item strong {
	font-weight: 575;
	color: var(--color-text);
}

.meta-date,
.recent-posts .posts .post .meta-date {
	font-size: var(--font-size-sm);
	color: var(--color-text-light);
	letter-spacing: 0.02em;
	text-transform: uppercase;
	font-weight: 400;
}

/* Only make meta-date block on homepage/list pages, not on single post pages */
.recent-posts .posts .post .meta-date,
.list .posts .post .meta-date,
.news_item .meta-date {
	display: block;
	margin-bottom: 0.25em;
}

.meta-divider {
	margin: 0 var(--space-sm);
	color: var(--color-text-light);
}

.meta-stat {
	font-size: var(--font-size-sm);
	color: var(--color-text-light);
}

.news-summary p {
	display: inline;
}

/* ============================================
   BLOG POST LISTS (Vicki Boykis style)
   ============================================ */

.list .posts {
	list-style: none;
	padding: 0;
	margin: 0;
}

.list .posts .post {
	display: flex;
	margin-bottom: var(--space-lg);
	align-items: baseline;
}

.list .posts .post .meta {
	flex: 0 0 130px;
	text-transform: uppercase;
	letter-spacing: 0.02em;
	margin-right: var(--space-md);
	margin-bottom: 0;
}

.list .posts .post a.title {
	font-weight: 400;
	font-size: var(--font-size-base);
	color: var(--color-primary);
	text-decoration: none;
}

.list .posts .post a.title:hover {
	text-decoration: underline;
}

/* Description styling - used on both home and blog list pages */
.description,
.list .posts .post .description,
.recent-posts .posts .post .description {
	color: var(--color-text-light);
	font-size: 0.9375rem;  /* 15px - between sm and base */
}

.list .posts .post > div {
	flex: 1;
}

/* ============================================
   INDIVIDUAL POSTS
   ============================================ */

.post .post-header {
	margin-bottom: var(--space-xl);  /* 2rem / 32px - space between header and content */
}

.post .post-header .page-title {
	margin-bottom: var(--space-xs);  /* 4px - tight spacing between title and meta */
}

/* .post .post-header .meta already inherits from base .meta */

.post .draft-label {
	color: var(--color-primary);
	text-decoration: none;
	padding: 2px 4px;
	border-radius: 4px;
	margin-left: 6px;
	background-color: var(--color-background-draft);
}

.post ul li {
	margin-bottom: 10px;
}

.post ul li p {
	display: inline;
}

.post-tags a {
	margin-right: 5px;
}

/* ============================================
   PAGE TITLES & SECTIONS
   ============================================ */

.page-title {
	margin: 0 0 var(--space-md);
	font-size: var(--font-size-2xl);
	line-height: 1.25;
	font-weight: 700;
	color: var(--color-text);
}

.section .section-header {
	font-size: var(--font-size-lg);
	font-weight: 300;
	text-transform: none;
	color: var(--color-text);
	margin-bottom: 25px;
	margin-top: 25px;
	letter-spacing: 1px;
}

.section-intro {
	font-size: var(--font-size-md);
	line-height: 1.7;
	margin-bottom: var(--space-xl);
}

.section-item {
	margin-bottom: var(--space-xl);
}

.section-item:last-of-type {
	margin-bottom: 0;
}

.section-item-header {
	margin-bottom: var(--space-sm);
}

.section-item .markdown p {
	margin: 0 0 var(--space-md);
}

.section-item .markdown p:last-child {
	margin-bottom: 0;
}

.section-item .markdown ul,
.section-item .markdown ol {
	margin: 0 0 var(--space-md) 1.2rem;
}

/* Publications/Projects page section headers */
/* Remove specific override - h2s now use base h2 styling (1.5rem) */
.post .markdown h2 {
	margin-top: var(--space-xl);  /* 2rem - reduced from 3rem */
	margin-bottom: var(--space-md);  /* 1rem - reduced from 2rem */
}

.post .markdown h2:first-of-type {
	margin-top: 0;
}

/* Publications/Projects page items - tighter spacing */
.post .markdown p {
	margin-bottom: var(--space-md);  /* 1rem - reduced from 1.5rem */
}

.post .markdown p:last-child {
	margin-bottom: 0;
}

/* ============================================
   LISTS
   ============================================ */

ul {
	list-style: disc inside;
	padding-left: 15px;
}

ul.flat {
	margin: 0;
	padding: 0;
}

ul.flat li {
	display: inline-block;
	list-style: none;
	margin-left: 0;
}

/* ============================================
   CONTENT ELEMENTS
   ============================================ */

hr {
	display: block;
	height: 1px;
	border: 0;
	border-top: 1px solid var(--color-border-dark);
	margin: var(--space-md) 0;
	padding: 0;
}

img {
	max-width: 100%;
	object-fit: contain;
}

a img {
	border: none;
}

figure {
	margin: 0;
	text-align: center;
}

fieldset {
	border: 0;
	margin: 0;
	padding: 0;
}

textarea {
	resize: vertical;
}

blockquote {
	margin-left: var(--space-md);
	font-style: italic;
	font-size: var(--font-size-base);
	font-family: var(--font-serif);
	border-left: 3px solid var(--color-primary);
	padding-left: var(--space-xl);
}

blockquote cite {
	opacity: 0.8;
}

blockquote em {
	font-weight: 575;
}

/* ============================================
   CODE & SYNTAX HIGHLIGHTING
   ============================================ */

.highlight pre {
	margin-bottom: 0;
	margin-top: 0;
	padding: var(--space-xl);
	background-color: transparent !important;
}

.highlight {
	background: 0 0;
	background-color: var(--color-background-subtle);
}

pre code {
	display: inline-block;
}

/* ============================================
   TABLES
   ============================================ */

table th {
	background-color: var(--color-border);
}

table th,
table td {
	padding: 10px var(--space-xl);
	border: 1px solid var(--color-border-dark);
}

/* ============================================
   PAGINATION
   ============================================ */

.pagination {
	margin: 0;
	padding: 0;
	text-align: left;
	display: flex;
	justify-content: space-between;
}

.pagination li {
	list-style: none;
	display: inline-block;
	margin: 0;
	padding: 0;
}

.pagination .page-prev {
	margin-right: var(--space-xl);
	padding-right: var(--space-xl);
}

.pagination .page-item.page-prev {
	text-align: left;
}

.pagination .page-item.page-next {
	text-align: right;
}

/* ============================================
   TAGS
   ============================================ */

.tag-cloud {
	margin-top: var(--space-xl);
}

.tag-cloud a {
	margin-right: 15px;
}

/* ============================================
   SPECIAL ELEMENTS
   ============================================ */

.paper {
	margin-bottom: 15px;
}

.responsive {
	max-width: 20%;
	height: auto;
}

.headshot_wrapper {
	display: inline;
	float: right;
	width: 100%;
	max-width: 25%;
	height: auto;
	margin: 0 auto;
	margin-left: var(--space-lg);
	margin-bottom: var(--space-md);
}

.headshot {
	height: auto;
}

/* Bio section - lighter bold weight */
#bio_text strong,
#bio_text b {
	font-weight: 575;
}

/* ============================================
   RESPONSIVE BREAKPOINTS
   ============================================ */

@media (max-width: 767px) {
	body {
		padding: var(--space-xl);
	}

	h1 { font-size: 1.8rem; }
	h2 { font-size: 1.6rem; }
	h3 { font-size: 1.2rem; }
	h4 { font-size: var(--font-size-base); }

	.container {
		margin-top: 10px;
	}
}

@media (max-width: 500px) {
	.headshot_wrapper {
		display: block;
		float: center;
		margin-left: var(--space-lg);
		max-width: 50%;
	}
}
